# Copy to .env — NEVER commit a real .env, NEVER put keys in code or chat.
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Ollama (local, no key): http://localhost:11434
OLLAMA_MODEL=llama3.1
# Twilio (real calls): https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vapi (real AI calls): https://dashboard.vapi.ai/
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
